#!/usr/bin/env bash
# Manual-first dotfiles installer: check, copy, or symlink configuration.

set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
INSTALL_MODE="copy"
DRY_RUN=false
ACTION="install"

OPTIONAL_COMPONENTS=(desktop git input niri noctalia umbriel)
NON_COMPONENT_DIRS=(docs nix)


usage() {
  cat <<EOF
Usage:
  $0 list
  $0 check [component... | all]
  $0 [install] [--copy | --link] [--dry-run] <component... | all>

Commands:
  list        List available components
  check       Check local dependencies; never installs anything
  install     Deploy configuration; copy is the default

Options:
  --copy      Copy files into HOME
  --link      Symlink files into HOME
  --dry-run   Show file operations without changing HOME

Examples:
  $0 check zsh tmux ghostty
  $0 all
  $0 niri noctalia input
  $0 --link zsh tmux ghostty
EOF
}


in_array() {
  local wanted="$1" item
  shift
  for item in "$@"; do
    [[ "$item" == "$wanted" ]] && return 0
  done
  return 1
}


is_optional() {
  in_array "$1" "${OPTIONAL_COMPONENTS[@]}"
}


is_non_component() {
  in_array "$1" "${NON_COMPONENT_DIRS[@]}"
}


get_components() {
  local dir name
  for dir in "$DOTFILES_DIR"/*/; do
    [[ -d "$dir" ]] || continue
    name="$(basename "$dir")"
    is_non_component "$name" && continue
    [[ -n "$(find "$dir" -type f -print -quit)" ]] || continue
    printf '%s\n' "$name"
  done | sort
}


component_exists() {
  local name
  while IFS= read -r name; do
    [[ "$name" == "$1" ]] && return 0
  done < <(get_components)
  return 1
}


list_components() {
  local name

  echo "Default components (installed by 'all'):"
  while IFS= read -r name; do
    is_optional "$name" && continue
    printf '  %s\n' "$name"
  done < <(get_components)

  echo
  echo "Optional components (must be named explicitly):"
  while IFS= read -r name; do
    is_optional "$name" || continue
    printf '  %s\n' "$name"
  done < <(get_components)
}


expand_selection() {
  local -a requested=("$@") unique=()
  local -A seen=()
  local name candidate

  SELECTED_COMPONENTS=()
  [[ ${#requested[@]} -gt 0 ]] || requested=(all)

  for name in "${requested[@]}"; do
    if [[ "$name" == "all" ]]; then
      while IFS= read -r candidate; do
        is_optional "$candidate" && continue
        SELECTED_COMPONENTS+=("$candidate")
      done < <(get_components)
    elif component_exists "$name"; then
      SELECTED_COMPONENTS+=("$name")
    else
      echo "Unknown component: $name" >&2
      echo "Run '$0 list' to see available components." >&2
      exit 1
    fi
  done

  for name in "${SELECTED_COMPONENTS[@]}"; do
    [[ -n "${seen[$name]+x}" ]] && continue
    seen["$name"]=1
    unique+=("$name")
  done
  SELECTED_COMPONENTS=("${unique[@]}")
}


probe_available() {
  local probes="$1" probe
  local IFS='|'

  for probe in $probes; do
    if [[ "$probe" == file:* ]]; then
      [[ -r "${probe#file:}" ]] && return 0
    elif command -v "$probe" >/dev/null 2>&1; then
      return 0
    fi
  done
  return 1
}


check_dependency() {
  local component="$1" level="$2" probes="$3" label="$4"

  if probe_available "$probes"; then
    printf '  [ok]               %-10s %s\n' "$component" "$label"
  else
    printf '  [missing:%-8s] %-10s %s\n' "$level" "$component" "$label"
    if [[ "$level" == "required" ]]; then
      ((REQUIRED_MISSING += 1))
    else
      ((OPTIONAL_MISSING += 1))
    fi
  fi
}


verify_manually() {
  printf '  [verify:%-9s] %-10s %s\n' "$2" "$1" "$3"
}


check_component() {
  case "$1" in
    desktop)
      check_dependency desktop optional 'pavucontrol|pwvucontrol' 'volume control UI'
      check_dependency desktop optional gsettings 'GSettings CLI'
      ;;
    ghostty)
      check_dependency ghostty required ghostty Ghostty
      verify_manually ghostty optional 'JetBrainsMono Nerd Font (or change font-family)'
      ;;
    git)
      ;;
    input)
      check_dependency input required fcitx5 Fcitx5
      verify_manually input required 'fcitx5-lotus engine'
      ;;
    niri)
      check_dependency niri required niri Niri
      check_dependency niri optional ghostty 'Ghostty keybinding'
      check_dependency niri optional qs 'Quickshell/Noctalia v4'
      check_dependency niri optional fcitx5 'Fcitx5 autostart'
      check_dependency niri optional gnome-keyring-daemon 'GNOME Keyring'
      check_dependency niri optional gsettings 'GSettings CLI'
      check_dependency niri optional firefox 'Firefox keybinding'
      check_dependency niri optional nautilus 'Nautilus keybinding'
      ;;
    noctalia)
      check_dependency noctalia required qs Quickshell
      check_dependency noctalia optional 'pavucontrol|pwvucontrol' 'volume control UI'
      verify_manually noctalia required 'Noctalia Shell legacy v4'
      ;;
    starship)
      check_dependency starship required starship Starship
      ;;
    tmux)
      check_dependency tmux required tmux tmux
      check_dependency tmux optional curl 'curl weather lookup'
      check_dependency tmux optional git 'Git for TPM'
      verify_manually tmux optional 'TPM plugins (Prefix + I)'
      ;;
    umbriel)
      check_dependency umbriel required umbriel Umbriel
      check_dependency umbriel optional noctalia 'Noctalia v5 CLI'
      check_dependency umbriel optional ghostty 'Ghostty keybinding'
      check_dependency umbriel optional fcitx5 'Fcitx5 autostart'
      check_dependency umbriel optional gnome-keyring-daemon 'GNOME Keyring'
      check_dependency umbriel optional gsettings 'GSettings CLI'
      ;;
    zsh)
      check_dependency zsh required zsh Zsh
      check_dependency zsh optional fzf 'fzf integration'
      check_dependency zsh optional zoxide 'zoxide integration'
      check_dependency zsh optional starship 'Starship prompt'
      check_dependency zsh optional \
        "file:/usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh|file:/usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh|file:$HOME/.nix-profile/share/zsh-autosuggestions/zsh-autosuggestions.zsh|file:/run/current-system/sw/share/zsh-autosuggestions/zsh-autosuggestions.zsh" \
        'Zsh autosuggestions'
      check_dependency zsh optional \
        "file:/usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh|file:/usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh|file:$HOME/.nix-profile/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh|file:/run/current-system/sw/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" \
        'Zsh syntax highlighting'
      check_dependency zsh optional docker 'Docker BentoPDF alias'
      check_dependency zsh optional git Git
      ;;
  esac
}


check_dependencies() {
  local component
  REQUIRED_MISSING=0
  OPTIONAL_MISSING=0

  echo "Dependency check (report only; nothing will be installed):"
  for component in "${SELECTED_COMPONENTS[@]}"; do
    check_component "$component"
  done

  echo
  printf 'Missing: %d required, %d optional detectable dependencies.\n' \
    "$REQUIRED_MISSING" "$OPTIONAL_MISSING"
  printf 'Guides: %s/docs/requirements.md\n' "$DOTFILES_DIR"
  [[ "$REQUIRED_MISSING" -eq 0 ]]
}


backup_path() {
  local dest="$1" backup base suffix

  if [[ -z "${BACKUP_DIR:-}" ]]; then
    base="$HOME/.dotfiles-backup/$(date +%Y%m%d-%H%M%S)"
    BACKUP_DIR="$base"
    suffix=1
    while [[ -e "$BACKUP_DIR" ]]; do
      BACKUP_DIR="$base.$suffix"
      ((suffix += 1))
    done
  fi
  backup="$BACKUP_DIR/${dest#"$HOME"/}"

  if [[ "$DRY_RUN" == true ]]; then
    printf '  [backup]  %s -> %s\n' "$dest" "$backup"
    return
  fi

  mkdir -p "$(dirname "$backup")"
  mv -- "$dest" "$backup"
  printf '  [backup]  %s -> %s\n' "$dest" "$backup"
}


deploy_file() {
  local src="$1" dest="$2"

  if [[ "$INSTALL_MODE" == "copy" && -f "$dest" && ! -L "$dest" ]] && cmp -s -- "$src" "$dest"; then
    printf '  [ok]      %s\n' "$dest"
    return
  fi
  if [[ "$INSTALL_MODE" == "link" && -L "$dest" && "$(readlink "$dest")" == "$src" ]]; then
    printf '  [ok]      %s\n' "$dest"
    return
  fi
  if [[ -e "$dest" || -L "$dest" ]]; then
    backup_path "$dest"
  fi

  if [[ "$DRY_RUN" == true ]]; then
    printf '  [%-7s] %s -> %s\n' "$INSTALL_MODE" "$src" "$dest"
    return
  fi

  mkdir -p "$(dirname "$dest")"
  if [[ "$INSTALL_MODE" == "copy" ]]; then
    cp -a -- "$src" "$dest"
  else
    ln -s -- "$src" "$dest"
  fi
  printf '  [%-7s] %s -> %s\n' "$INSTALL_MODE" "$src" "$dest"
}


install_component() {
  local name="$1" component_dir="$DOTFILES_DIR/$1" file rel

  printf 'Installing %s (%s):\n' "$name" "$INSTALL_MODE"
  while IFS= read -r -d '' file; do
    rel="${file#"$component_dir"/}"
    deploy_file "$file" "$HOME/$rel"
  done < <(find "$component_dir" -type f -print0 | sort -z)
}


[[ $# -gt 0 ]] || {
  usage
  exit 1
}

case "$1" in
  list)
    list_components
    exit 0
    ;;
  check|install)
    ACTION="$1"
    shift
    ;;
  --help|-h)
    usage
    exit 0
    ;;
esac

declare -a REQUESTED=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --copy) INSTALL_MODE="copy" ;;
    --link) INSTALL_MODE="link" ;;
    --dry-run) DRY_RUN=true ;;
    --help|-h)
      usage
      exit 0
      ;;
    --*)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
    *) REQUESTED+=("$1") ;;
  esac
  shift
done

if [[ "$ACTION" != "install" && "$DRY_RUN" == true ]]; then
  echo "--dry-run is only valid for file installation." >&2
  exit 1
fi

declare -a SELECTED_COMPONENTS=()
expand_selection "${REQUESTED[@]}"

case "$ACTION" in
  check)
    check_dependencies
    ;;
  install)
    for name in "${SELECTED_COMPONENTS[@]}"; do
      install_component "$name"
    done
    ;;
esac
