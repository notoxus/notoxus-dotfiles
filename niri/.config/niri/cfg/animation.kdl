    // Present
    animations {
        // Values below 1 make the remaining default animations faster.
        slowdown 0.7

        window-open {
            off
        }
        window-close {
            off
        }
        config-notification-open-close {
            off
        }
        screenshot-ui-open {
            off
        }
    }
