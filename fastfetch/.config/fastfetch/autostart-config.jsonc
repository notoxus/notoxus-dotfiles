{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",

  "logo": {
    "type": "small",
    "padding": {
      "right": 2
    }
  },

  "display": {
    "separator": "  ",
    "color": {
      "keys": "blue",
      "separator": "light_black"
    }
  },

  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": "OS"
    },
    {
      "type": "kernel",
      "key": "Kernel"
    },
    {
      "type": "uptime",
      "key": "Uptime"
    },
    {
      "type": "packages",
      "key": "Packages",
      "combined": true
    },
    {
      "type": "shell",
      "key": "Shell"
    },
    {
      "type": "wm",
      "key": "Session"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
