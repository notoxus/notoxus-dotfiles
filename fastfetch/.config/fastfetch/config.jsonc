{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",

  "logo": {
    "type": "auto"
  },

  "display": {
    "separator": " ➜ "
  },

  "modules": [
    {
      "type": "custom",
      "format": "┌──────────── Hardware Information ────────────┐"
    },
    {
      "type": "host",
      "key": "󰌢"
    },
    {
      "type": "cpu",
      "key": ""
    },
    {
      "type": "gpu",
      "key": "󰍛"
    },
    {
      "type": "disk",
      "key": ""
    },
    {
      "type": "memory",
      "key": ""
    },
    {
      "type": "swap",
      "key": "󰓡"
    },
    {
      "type": "display",
      "key": "󰍹"
    },
    {
      "type": "brightness",
      "key": "󰃠"
    },
    {
      "type": "battery",
      "key": ""
    },
    {
      "type": "poweradapter",
      "key": "󰚥"
    },
    {
      "type": "sound",
      "key": ""
    },
    {
      "type": "custom",
      "format": "├──────────── Software Information ────────────┤"
    },
    {
      "type": "title",
      "key": ""
    },
    {
      "type": "os",
      "key": ""
    },
    {
      "type": "kernel",
      "key": ""
    },
    {
      "type": "uptime",
      "key": "󰅐"
    },
    {
      "type": "packages",
      "key": "󰏖"
    },
    {
      "type": "shell",
      "key": ""
    },
    {
      "type": "de",
      "key": ""
    },
    {
      "type": "wm",
      "key": ""
    },
    {
      "type": "wmtheme",
      "key": "󰉼"
    },
    {
      "type": "theme",
      "key": "󰉼"
    },
    {
      "type": "icons",
      "key": "󰀻"
    },
    {
      "type": "terminal",
      "key": ""
    },
    {
      "type": "terminalfont",
      "key": ""
    },
    {
      "type": "locale",
      "key": "󰗊"
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────────┘"
    },

    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
