#!/usr/bin/env zsh

case "${1:-}" in
  g|ghostty)
  ghostty +list-keybinds --default |
    awk '
      /^keybind = / {
        line = $0
        sub(/^keybind = /, "", line)

        # Find the "=" that separates trigger from action.
        # This also handles keys such as ctrl+= correctly.
        if (match(line, /=[[:alpha:]_]/)) {
          key = substr(line, 1, RSTART - 1)
          action = substr(line, RSTART + 1)

          printf "%-24s %s\n", key, action
        }
      }
    ' |
    fzf \
      --prompt='Ghostty keybinds > ' \
      --layout=reverse \
      --border \
      --info=inline \
      --header='KEY                      ACTION'
  ;;

  t|tmux)
    echo "Use: Ctrl+B ?"
    ;;

  *)
    echo "Usage:"
    echo "  keys g    Ghostty keybinds"
    echo "  keys t    tmux help"
    ;;
esac