# Ghostty config
# Install at: ~/.config/ghostty/config.ghostty
# --- Font ---
font-family = JetBrainsMono Nerd Font Mono
font-family-bold = JetBrainsMono Nerd Font Mono
font-family-italic = JetBrainsMono Nerd Font Mono
font-family-bold-italic = JetBrainsMono Nerd Font Mono
font-size = 12
# --- Window ---
window-padding-x = 0
window-padding-y = 0
window-padding-balance = true
window-decoration = none
window-theme = dark
background-opacity = 0.9
# --- Scrollback ---
scrollback-limit = 10000000
mouse-scroll-multiplier = 3
# --- Color ---
theme = TokyoNight
bold-is-bright = true
# --- Cursor ---
cursor-style = underline
cursor-style-blink = false
# --- Mouse / clipboard ---
mouse-hide-while-typing = true
# Always reserve Shift+drag for native terminal selection, even when tmux
# has mouse reporting enabled. Plain drag remains available to tmux.
mouse-shift-capture = never
copy-on-select = true
