# Ghostty config
# Install at: ~/.config/ghostty/config
# --- Font ---
font-family = JetBrainsMono Nerd Font Mono
font-family-bold = JetBrainsMono Nerd Font Mono
font-family-italic = JetBrainsMono Nerd Font Mono
font-family-bold-italic = JetBrainsMono Nerd Font Mono
font-size = 12
# --- Window ---
window-padding-x = 0
window-padding-y = 0
window-padding-balance = true
window-decoration = true
window-theme = dark
background-opacity = 0.8
# --- Scrollback ---
scrollback-limit = 10000000
mouse-scroll-multiplier = 3
background = #2E3440
foreground = #D8DEE9
bold-is-bright = true
# --- Color ---
selection-background = #4C566A
selection-foreground = #D8DEE9
palette = 0=#3B4252
palette = 1=#BF616A
palette = 2=#A3BE8C
palette = 3=#EBCB8B
palette = 4=#81A1C1
palette = 5=#B48EAD
palette = 6=#88C0D0
palette = 7=#E5E9F0
palette = 8=#4C566A
palette = 9=#BF616A
palette = 10=#A3BE8C
palette = 11=#EBCB8B
palette = 12=#81A1C1
palette = 13=#B48EAD
palette = 14=#8FBCBB
palette = 15=#ECEFF4
# --- Cursor ---
cursor-style = underline
cursor-style-blink = false
# --- Mouse / clipboard ---
mouse-hide-while-typing = true
copy-on-select = true
