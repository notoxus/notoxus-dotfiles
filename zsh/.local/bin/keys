#!/usr/bin/env zsh

show_usage() {
  cat <<'EOF'
Usage:
  keys g    Search Ghostty's default keybindings
  keys n    Search the installed Niri keybindings
  keys t    Show how to open tmux's built-in keybinding help
EOF
}

case "${1:-}" in
  g|ghostty)
    if (( ! $+commands[ghostty] )); then
      print -u2 "keys: ghostty is not installed"
      exit 1
    fi

    if (( ! $+commands[fzf] )); then
      print -u2 "keys: fzf is not installed"
      exit 1
    fi

    ghostty +list-keybinds --default |
      awk '
        /^keybind = / {
          line = $0
          sub(/^keybind = /, "", line)

          # Find the separator while preserving keys such as ctrl+=.
          if (match(line, /=[[:alpha:]_]/)) {
            key = substr(line, 1, RSTART - 1)
            action = substr(line, RSTART + 1)
            printf "%-24s %s\n", key, action
          }
        }
      ' |
      fzf \
        --prompt='Ghostty keybinds > ' \
        --layout=reverse \
        --border \
        --info=inline \
        --header='KEY                      ACTION'
    ;;

  n|niri)
    config_root="${XDG_CONFIG_HOME:-$HOME/.config}/niri"
    config_file="${NIRI_CONFIG:-$config_root/config.kdl}"
    keybind_file="${config_file:h}/cfg/keybinds.kdl"

    # This dotfiles layout keeps binds in cfg/keybinds.kdl. Fall back to the
    # main config so the helper also works with an inline Niri configuration.
    if [[ ! -r "$keybind_file" ]]; then
      keybind_file="$config_file"
    fi

    if [[ ! -r "$keybind_file" ]]; then
      print -u2 "keys: Niri config not found: $config_file"
      exit 1
    fi

    niri_bindings() {
      awk '
        /^[[:space:]]*(Mod|CTRL|ALT|Shift|XF86)[^[:space:]]*[[:space:]]/ {
          line = $0
          sub(/^[[:space:]]*/, "", line)

          key = line
          sub(/[[:space:]].*$/, "", key)

          title = ""
          if (match(line, /hotkey-overlay-title="[^"]+"/)) {
            title = substr(line, RSTART, RLENGTH)
            sub(/^hotkey-overlay-title="/, "", title)
            sub(/"$/, "", title)
          } else if (match(line, /\{[^}]+;/)) {
            title = substr(line, RSTART + 1, RLENGTH - 2)
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", title)
            gsub(/[[:space:]]+/, " ", title)
          }

          if (title != "") {
            printf "%-34s %s\n", key, title
          }
        }
      ' "$keybind_file"
    }

    if (( $+commands[fzf] )); then
      niri_bindings | fzf \
        --prompt='Niri keybinds > ' \
        --layout=reverse \
        --border \
        --info=inline \
        --header='KEY                                ACTION'
    else
      print 'KEY                                ACTION'
      niri_bindings
    fi
    ;;

  t|tmux)
    print "Inside tmux, press Ctrl+B, release it, then press ?"
    ;;

  -h|--help|"")
    show_usage
    ;;

  *)
    print -u2 "keys: unknown target: $1"
    show_usage >&2
    exit 2
    ;;
esac
